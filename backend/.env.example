# Application
APP_NAME=DuoFlow Finance
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://duoflow:duoflow123@postgres:5432/duoflow
DB_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (⚠️ CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - origines autorisées (comma-separated)
# Vite dev (:5173), Docker frontend (:5000), et variantes 127.0.0.1
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5000,http://127.0.0.1:5173

# Security
BCRYPT_ROUNDS=12
