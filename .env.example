# =============================================================================
# MIMO FINANCE - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env file to git!
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (true only in development!)
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://duoflow:duoflow123@postgres:5432/duoflow

# Database credentials (used by scripts)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=duoflow
DB_USER=duoflow
DB_PASSWORD=duoflow123

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection URL
# Format: redis://host:port/db
REDIS_URL=redis://redis:6379/0

# Redis credentials
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# JWT & SECURITY
# =============================================================================
# JWT secret key - MUST be changed in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# JWT expiration times (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Password hashing
# Bcrypt rounds (4 for dev/test, 12+ for production)
BCRYPT_ROUNDS=12

# =============================================================================
# CORS & API
# =============================================================================
# API Base URL
API_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
# Development: http://localhost:5000,http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per minute
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_USER_MINUTE=500

# =============================================================================
# FILE UPLOADS
# =============================================================================
# Max file size (in MB)
MAX_UPLOAD_SIZE_MB=5

# Upload directory
UPLOADS_DIR=/app/uploads

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=/app/logs

# Log rotation (days)
LOG_RETENTION_DAYS=30

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Vite API URL (for frontend)
VITE_API_URL=http://localhost:8000

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Container restart policy: no, always, on-failure, unless-stopped
RESTART_POLICY=unless-stopped

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup directory (host path)
BACKUP_DIR=./backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Health check interval (seconds)
HEALTHCHECK_INTERVAL=30

# Health check timeout (seconds)
HEALTHCHECK_TIMEOUT=10

# Health check retries
HEALTHCHECK_RETRIES=3

# =============================================================================
# PRODUCTION ONLY (uncomment and fill for production)
# =============================================================================

# # Sentry DSN (error tracking)
# SENTRY_DSN=

# # AWS S3 (file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# # SMTP (email sending)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# # SSL/TLS Certificates
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# =============================================================================
# CI/CD SECRETS (GitHub Actions)
# =============================================================================
# These should be set as GitHub Secrets, not in .env file!
# - DOCKER_USERNAME
# - DOCKER_PASSWORD
# - SONAR_TOKEN
# - GCP_PROJECT_ID
# - GCP_SA_KEY
# =============================================================================
