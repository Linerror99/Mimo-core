FROM python:3.11-slim

WORKDIR /app

# Installation FastAPI minimal
RUN pip install --no-cache-dir fastapi uvicorn

# App minimale
RUN echo 'from fastapi import FastAPI\n\
app = FastAPI()\n\
\n\
@app.get("/health")\n\
def health():\n\
    return {"status": "ok"}\n\
\n\
@app.get("/")\n\
def root():\n\
    return {"message": "Mimo Backend - Placeholder"}' > main.py

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
